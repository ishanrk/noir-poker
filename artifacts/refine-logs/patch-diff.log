-+async fn finalize_ceremony(
-+    tx: &mut Transaction<'_, Postgres>,
-+    room: Uuid,
-+    ceremony: &Ceremony,
-+    final_seed: &[u8; 32],
-+) -> FairResult<()> {
-+    let shares = ceremony
-+        .shares
