-+         WHERE hands.room_id = $1 ORDER BY hands.hand_no DESC LIMIT 1",
-+    )
-+    .bind(room)
-+    .fetch_optional(db.pool())
-+    .await?;
-+
-+    row.map(|row| bytes(row.try_get("commitment")?)).transpose()
